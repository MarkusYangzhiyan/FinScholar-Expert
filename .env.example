# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://127.0.0.1:3000"]
GPU_OPERATIONS_ENABLED=false

# Paths are resolved relative to PROJECT_ROOT unless an absolute path is given.
PROJECT_ROOT=
DATA_DIR=data
ARTIFACT_DIR=artifacts
LOG_DIR=logs
RUN_DIR=run

# -----------------------------------------------------------------------------
# Shared network policy
# -----------------------------------------------------------------------------
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1

# -----------------------------------------------------------------------------
# ModelScope and local model paths
# -----------------------------------------------------------------------------
MODELSCOPE_TOKEN=
MODELSCOPE_CACHE=cache/modelscope

QWEN_MODELSCOPE_ID=Qwen/Qwen3.5-4B
QWEN_MODELSCOPE_REVISION=
QWEN_MODEL_PATH=models/pretrained/qwen3.5-4b

BGE_M3_MODELSCOPE_ID=BAAI/bge-m3
BGE_M3_MODELSCOPE_REVISION=
EMBEDDING_MODEL_PATH=models/pretrained/bge-m3

BGE_RERANKER_MODELSCOPE_ID=BAAI/bge-reranker-v2-m3
BGE_RERANKER_MODELSCOPE_REVISION=
RERANKER_MODEL_PATH=models/pretrained/bge-reranker-v2-m3

LORA_ADAPTER_PATH=models/lora/finscholar-router

# -----------------------------------------------------------------------------
# Local Qwen router served by vLLM
# -----------------------------------------------------------------------------
ROUTER_BACKEND=vllm
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL=qwen-router
QWEN_ENABLE_THINKING=false
QWEN_REQUEST_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Cloud generation model: DeepSeek-v4 API
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Vision model: Qwen-VL-Max API
# -----------------------------------------------------------------------------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max
QWEN_VL_REQUEST_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# LightRAG
# -----------------------------------------------------------------------------
LIGHTRAG_ENABLED=true
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_WORKING_DIR=data/lightrag
LIGHTRAG_QUERY_MODE=mix
LIGHTRAG_LLM_BACKEND=deepseek
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage
LIGHTRAG_KV_STORAGE=
LIGHTRAG_GRAPH_STORAGE=
LIGHTRAG_DOC_STATUS_STORAGE=
LIGHTRAG_REQUEST_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Hybrid retrieval
# -----------------------------------------------------------------------------
EMBEDDING_BACKEND=bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_BACKEND=bge-reranker-v2-m3
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=80
DENSE_TOP_K=30
SPARSE_TOP_K=30
LIGHTRAG_TOP_K=30
RERANK_TOP_K=10

# -----------------------------------------------------------------------------
# Milvus
# -----------------------------------------------------------------------------
VECTOR_STORE_BACKEND=milvus
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION_PREFIX=finscholar
MILVUS_DENSE_DIMENSION=1024
MILVUS_METRIC_TYPE=COSINE

# -----------------------------------------------------------------------------
# External tools
# -----------------------------------------------------------------------------
TAVILY_API_KEY=
WEB_SEARCH_PRIMARY=tavily
WEB_SEARCH_FALLBACK=ddgs
WIKIPEDIA_LANGUAGE=zh
WIKIPEDIA_USER_AGENT=FinScholar-Expert/0.1 contact=replace-with-email@example.com
ARXIV_PAGE_SIZE=20
ARXIV_DELAY_SECONDS=3
ARXIV_MAX_RETRIES=3
YFINANCE_REQUEST_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Python sandbox
# -----------------------------------------------------------------------------
SANDBOX_BACKEND=docker
SANDBOX_BASE_URL=
SANDBOX_NETWORK_ENABLED=false
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT_MB=1024
SANDBOX_CPU_LIMIT=1
SANDBOX_PROCESS_LIMIT=64
SANDBOX_OUTPUT_LIMIT_BYTES=10485760

# -----------------------------------------------------------------------------
# Logging and audit
# -----------------------------------------------------------------------------
LOG_FORMAT=json
AUDIT_ENABLED=true
AUDIT_HASH_ALGORITHM=sha256
